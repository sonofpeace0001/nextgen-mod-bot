DISCORD_BOT_TOKEN=your-bot-token
GROQ_API_KEY=your-groq-api-key
GUILD_ID=your-guild-id
LOG_CHANNEL_ID=your-log-channel-id
WELCOME_CHANNEL_ID=your-welcome-channel-id

# Postgres (Supabase) persistence -- was local SQLite, which Railway wipes on every
# deploy/restart. Tables live in a dedicated mod_bot schema; the role below is scoped
# to ONLY that schema (no access to anything else in the Supabase project).
#
# MUST be the Supavisor pooler (session mode, port 5432), not the direct db.<ref>.
# supabase.co host: the direct host is IPv6-only and Railway has no IPv6 egress, so it
# fails with "Network is unreachable" every time. Find your project's exact pooler
# host+port in the Supabase dashboard (Connect button > Session pooler) -- it's a
# region+shard host (e.g. aws-1-eu-central-1, not necessarily aws-0-) specific to your
# project, and SUPABASE_DB_USER must carry the .<project-ref> suffix or Supavisor
# rejects it with "tenant/user not found" even with the right password.
SUPABASE_DB_HOST=aws-1-eu-central-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=mod_bot_service.hvwuozfsdckopxlbailm
SUPABASE_DB_PASSWORD=your-mod-bot-service-role-password

# Welcome-DM replies (Task 1) get forwarded here. Any private staff/internal channel id.
# If left unset, replies fall back to LOG_CHANNEL_ID so they're never dropped.
STAFF_CHANNEL_ID=your-staff-channel-id

# Daily prompt scheduler (Task 2)
PROMPT_CHANNEL_ID=your-public-prompt-channel-id
PROMPT_HOUR=19
PROMPT_TZ=Africa/Lagos

# Announcements channel: bot never sends conversational/tutor/chat/prompt messages here.
ANNOUNCEMENT_CHANNEL_ID=your-announcements-channel-id

# Tickets: when true (default) the bot does NOT auto-reply in ticket channels
# (light moderation for phishing/spam still runs). Set false to restore ticket auto-support.
DISABLE_TICKET_REPLIES=true

# CREAO is recommended first everywhere; link is fixed and enforced in code.
CREAO_LINK=https://creao.ai/@Sonofpeace

# NEXTGEN Academy website: the structured course now lives here, not in the bot.
ACADEMY_LINK=https://nextgenai-web.vercel.app/

# Help/tutor channel id so the tutor + prompt-helper can trigger there.
CH_HELP=your-help-channel-id

# Retention: each non-immune, non-founder member must send AUTO_KICK_REQUIRED_MESSAGES
# messages within a rolling AUTO_KICK_INACTIVE_DAYS-day cycle, or they're kicked when it
# ends. At AUTO_KICK_WARNING_DAYS into the cycle (the halfway point), anyone still short
# is pinged once in RETENTION_WARNING_CHANNEL_ID with their progress and days left.
# Leave RETENTION_WARNING_CHANNEL_ID unset to skip just the warning ping (the kick still
# runs). The bot's role needs "Kick Members" permission. Set AUTO_KICK_ENABLED=false to
# disable the whole feature.
AUTO_KICK_ENABLED=true
AUTO_KICK_INACTIVE_DAYS=14
AUTO_KICK_REQUIRED_MESSAGES=10
AUTO_KICK_WARNING_DAYS=7
RETENTION_WARNING_CHANNEL_ID=1536365838276235306
RETENTION_CHECK_HOUR=3

# Daily social-media reminder: nudges members to check today's NEXTGEN post on socials.
# Channel falls back to PROMPT_CHANNEL_ID if left unset.
SOCIAL_REMINDER_ENABLED=true
SOCIAL_REMINDER_CHANNEL_ID=your-public-channel-id
SOCIAL_REMINDER_HOUR=12
SOCIAL_LINKS=https://x.com/G_NEXTGEN
