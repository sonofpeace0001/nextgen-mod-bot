DISCORD_BOT_TOKEN=your-bot-token
GROQ_API_KEY=your-groq-api-key
GUILD_ID=your-guild-id
LOG_CHANNEL_ID=your-log-channel-id
WELCOME_CHANNEL_ID=your-welcome-channel-id

# Postgres (Supabase) persistence -- was local SQLite, which Railway wipes on every
# deploy/restart. Tables live in a dedicated mod_bot schema; the role below is scoped
# to ONLY that schema (no access to anything else in the Supabase project).
#
# MUST be the Supavisor pooler (session mode, port 5432), not the direct db.<ref>.
# supabase.co host: the direct host is IPv6-only and Railway has no IPv6 egress, so it
# fails with "Network is unreachable" every time. Find your project's exact pooler
# host+port in the Supabase dashboard (Connect button > Session pooler) -- it's a
# region+shard host (e.g. aws-1-eu-central-1, not necessarily aws-0-) specific to your
# project, and SUPABASE_DB_USER must carry the .<project-ref> suffix or Supavisor
# rejects it with "tenant/user not found" even with the right password.
SUPABASE_DB_HOST=aws-1-eu-central-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=mod_bot_service.hvwuozfsdckopxlbailm
SUPABASE_DB_PASSWORD=your-mod-bot-service-role-password

# Welcome-DM replies (Task 1) get forwarded here. Any private staff/internal channel id.
# If left unset, replies fall back to LOG_CHANNEL_ID so they're never dropped.
STAFF_CHANNEL_ID=your-staff-channel-id

# Daily prompt scheduler (Task 2)
PROMPT_CHANNEL_ID=your-public-prompt-channel-id
# UTC. 18:00 UTC is the same time of day as 19:00 in Lagos.
PROMPT_HOUR=18
PROMPT_TZ=UTC

# Announcements channel: bot never sends conversational/tutor/chat/prompt messages here.
ANNOUNCEMENT_CHANNEL_ID=your-announcements-channel-id

# Tickets: when true (default) the bot does NOT auto-reply in ticket channels
# (light moderation for phishing/spam still runs). Set false to restore ticket auto-support.
DISABLE_TICKET_REPLIES=true

# CREAO is recommended first everywhere; link is fixed and enforced in code.
CREAO_LINK=https://creao.ai/@Sonofpeace

# NEXTGEN Academy website: the structured course now lives here, not in the bot.
ACADEMY_LINK=https://nextgenai-web.vercel.app/

# Help/tutor channel id so the tutor + prompt-helper can trigger there.
CH_HELP=your-help-channel-id

# Retention: each non-immune, non-founder member must send AUTO_KICK_REQUIRED_MESSAGES
# messages within a rolling AUTO_KICK_INACTIVE_DAYS-day cycle, or they're kicked when it
# ends. At AUTO_KICK_WARNING_DAYS into the cycle (the halfway point), anyone still short
# is pinged once in RETENTION_WARNING_CHANNEL_ID with their progress and days left.
# Leave RETENTION_WARNING_CHANNEL_ID unset to skip just the warning ping (the kick still
# runs). The bot's role needs "Kick Members" permission. Set AUTO_KICK_ENABLED=false to
# disable the whole feature.
AUTO_KICK_ENABLED=true
AUTO_KICK_INACTIVE_DAYS=14
AUTO_KICK_REQUIRED_MESSAGES=10
AUTO_KICK_WARNING_DAYS=7
RETENTION_WARNING_CHANNEL_ID=1536365838276235306
RETENTION_CHECK_HOUR=3

# Daily social-media reminder: nudges members to check today's NEXTGEN post on socials.
# Channel falls back to PROMPT_CHANNEL_ID if left unset.
SOCIAL_REMINDER_ENABLED=true
SOCIAL_REMINDER_CHANNEL_ID=your-public-channel-id
SOCIAL_REMINDER_HOUR=12
SOCIAL_LINKS=https://x.com/G_NEXTGEN

# ---------------------------------------------------------------------------
# Points: Reach XP and Builder XP. Proof posted in channels, checked by a human reviewer,
# counted in cycles, used to choose the next Elites. Point values live in points_config.py.
# ALL points time is UTC: days, weeks and cycles all start at 00:00:00 UTC.
# ---------------------------------------------------------------------------

# Proof channels. There is no Academy channel any more.
# A channel left unset (0) is simply not a proof channel.
REACH_CHANNEL_ID=your-reach-proof-channel-id
BUILD_CHANNEL_ID=1529120140711432344
TUTORIAL_CHANNEL_ID=1520157303054139492
PROMPT_RESULT_CHANNEL_ID=1492637326541590790

# Where the weekly challenge is posted (must not be an announcement, ignored or ticket channel).
CHALLENGE_CHANNEL_ID=your-challenge-channel-id

# Review (Reach proof cards, engagement claims, spam alerts) goes to LOG_CHANNEL_ID.
# Only set this to send reviews somewhere else.
# STAFF_REVIEW_CHANNEL_ID=

# Proof channels whose Approve / Decline buttons sit right under the member's post (no command
# needed). Anything not listed sends its review card to the log channel instead.
REVIEW_IN_CHANNEL_KEYS=build,tutorial,prompt_result

# ONE leaderboard channel: two live messages (Build, Reach) edited in place, and the only place
# the leaderboard commands work for anyone without a role above Elite.
LEADERBOARD_CHANNEL_ID=your-leaderboard-channel-id
# Optional: a different channel for the commands (defaults to LEADERBOARD_CHANNEL_ID).
# LEADERBOARD_COMMAND_CHANNEL_ID=

# Roles. SET ELITE_ROLE_ID: only people whose highest role sits ABOVE it (plus the founder and
# Administrators) can approve proof, verify claims and post official posts; Elites start from
# zero (their old XP is not imported) and are visible on the leaderboards.
# STAFF_ROLE_IDS adds roles treated as above Elite. REVIEWER_ROLE_IDS adds extra reviewer roles.
ELITE_ROLE_ID=your-elite-role-id
STAFF_ROLE_IDS=
REVIEWER_ROLE_IDS=

# Cycles. CYCLE_START_DATE is YYYY-MM-DD, read as 00:00:00 UTC on that date.
# POINTS_TZ is not used for any calculation; a value other than UTC just logs a warning.
POINTS_TZ=UTC
CYCLE_START_DATE=2026-10-05
CYCLE_LENGTH_DAYS=14

# Optional ceiling on each member's CYCLE XP per lane. 0 = no ceiling (the default): members can
# earn as much as they like; 100 Reach and 100 Builder is only the minimum for Elite.
POINTS_CAP=0

# Elite is automatic: a member who reaches BOTH minimums in cycle XP gets the role at once, and an
# Elite who has not reached both when the cycle closes loses it. The bot needs Manage Roles and a
# role above the Elite role. ELITE_SLOTS_PER_CYCLE only limits the /cycle review list.
ELITE_MIN_REACH=100
ELITE_MIN_BUILDER=100
ELITE_SLOTS_PER_CYCLE=5

# Reach proof timing and account checks
OFFICIAL_POST_WINDOW_MINUTES=120
MIN_ACCOUNT_AGE_DAYS=7

# /xpost announcements: role to ping (falls back to MEMBER_ROLE_ID) and where to post
# (falls back to the channel the command was run in). The daily leaderboard posts to the
# same channel at XP_LEADERBOARD_HOUR, in UTC (08:00 UTC = 09:00 in Lagos).
XP_PING_ROLE_ID=your-member-role-id
XP_LEADERBOARD_ENABLED=true
XP_LEADERBOARD_HOUR=0
